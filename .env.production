# Production Build Configuration
GENERATE_SOURCEMAP=false
ESLINT_NO_DEV_ERRORS=true
CI=false
DISABLE_ESLINT_PLUGIN=true
TSC_COMPILE_ON_ERROR=true
INLINE_RUNTIME_CHUNK=false

# Performance Optimizations
REACT_APP_ENABLE_BUNDLE_ANALYZER=false
REACT_APP_ENABLE_PROFILING=false

# API Configuration
REACT_APP_API_URL=https://social-commerce-backend.vercel.app
REACT_APP_WS_URL=wss://social-commerce-backend.vercel.app

# Cache Configuration
REACT_APP_CACHE_DURATION=3600000
REACT_APP_ENABLE_CACHE=true

# Feature Flags for Production
REACT_APP_ENABLE_REAL_PRODUCTS=true
REACT_APP_ENABLE_REAL_REVIEWS=true
REACT_APP_ENABLE_PRICE_TRACKING=true
REACT_APP_ENABLE_MULTI_SOURCE=true
REACT_APP_ENABLE_ANALYTICS=true
REACT_APP_ENABLE_ERROR_REPORTING=true

# Security Headers
REACT_APP_ENABLE_CSP=true
REACT_APP_ENABLE_HSTS=true

# PWA Configuration
REACT_APP_ENABLE_PWA=true
REACT_APP_PWA_OFFLINE_SUPPORT=true
